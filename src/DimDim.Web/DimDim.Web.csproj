<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DimDim.Web</RootNamespace>
    <AssemblyName>DimDim.Web</AssemblyName>
    <!-- Usado apenas pelo "dotnet user-secrets" no desenvolvimento local (nenhum segredo fica no repositório) -->
    <UserSecretsId>7d0e5b0e-3c1a-4c1f-9a53-0d1d1c5a2e10</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application Insights (distro OpenTelemetry recomendado pela Microsoft para apps novos) -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.*" />
    <!-- Acesso ao Azure SQL Database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
  </ItemGroup>

</Project>
