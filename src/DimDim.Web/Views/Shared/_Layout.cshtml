@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    Func<string, string> ativo = nome =>
        string.Equals(controlador, nome, StringComparison.OrdinalIgnoreCase) ? "ativo" : "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - dimdim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <div class="container topo-conteudo">
            <a class="marca" asp-controller="Home" asp-action="Index">
                <span class="balao" aria-hidden="true"><span>dim</span><span>dim</span></span>
                <span class="marca-nome">dimdim</span>
            </a>
            <nav class="menu" aria-label="Principal">
                <a class="@ativo("Home")" asp-controller="Home" asp-action="Index">Início</a>
                <a class="@ativo("Clientes")" asp-controller="Clientes" asp-action="Index">Clientes</a>
                <a class="@ativo("Transacoes")" asp-controller="Transacoes" asp-action="Index">Transações</a>
            </nav>
        </div>
    </header>

    <main class="container conteudo">
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }
        @if (TempData["Erro"] is string erro)
        {
            <div class="alert alert-danger" role="alert">@erro</div>
        }
        @RenderBody()
    </main>

    <footer class="rodape">
        <div class="container">
            Projeto do 2º Checkpoint de DevOps Tools &amp; Cloud Computing (FIAP). Aplicação em Azure App Service, dados em Azure SQL Database, monitoramento com Application Insights.
        </div>
    </footer>
</body>
</html>
