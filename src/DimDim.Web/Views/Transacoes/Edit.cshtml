@model Transacao
@{
    ViewData["Title"] = "Editar transação";
}

<div class="cabecalho-pagina">
    <h1>Editar transação</h1>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="formulario">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />
    <partial name="_Campos" model="Model" />
    <div class="form-acoes">
        <button type="submit" class="btn btn-dim">Salvar alterações</button>
        <a class="btn btn-contorno" asp-action="Index">Cancelar</a>
    </div>
</form>
