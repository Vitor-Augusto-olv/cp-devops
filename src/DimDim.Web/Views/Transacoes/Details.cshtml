@model Transacao
@{
    ViewData["Title"] = "Transação " + Model.Id;
}

<div class="cabecalho-pagina">
    <div>
        <h1>@Model.Descricao</h1>
        <p class="sub">@Model.Valor.ToString("C2"), @Model.Tipo.Nome()</p>
    </div>
    <div class="acoes">
        <a class="btn btn-contorno" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn btn-perigo" asp-action="Delete" asp-route-id="@Model.Id">Excluir</a>
    </div>
</div>

<dl class="ficha">
    <div><dt>Cliente</dt><dd><a asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.ClienteId">@Model.Cliente?.Nome</a></dd></div>
    <div><dt>Data e hora</dt><dd>@Model.DataTransacao.ToString("dd/MM/yyyy HH:mm")</dd></div>
    <div><dt>Status</dt><dd><span class="status status-@Model.Status.ToString().ToLower()">@Model.Status.Nome()</span></dd></div>
</dl>

<p><a asp-action="Index">Voltar para a lista de transações</a></p>
